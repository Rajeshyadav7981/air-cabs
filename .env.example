# Booking alerts. Set these in Vercel → Project → Settings → Environment Variables,
# then redeploy. For local testing copy this file to .env. Full guide: SETUP-BOOKINGS.md

# 1) WhatsApp alert to your phone (free, via CallMeBot)
CALLMEBOT_PHONE=+917676950652
CALLMEBOT_APIKEY=

# 2) Google Sheet booking log (Apps Script web app URL + the SECRET from integrations/google-sheet.gs)
GOOGLE_SHEET_URL=
GOOGLE_SHEET_SECRET=

# Optional: Telegram alert as well
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
